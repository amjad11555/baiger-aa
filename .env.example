# ===== إعدادات الخادم =====
PORT=3000

# ===== WhatsApp Cloud API (من Meta) =====
# رمز الوصول الدائم (Permanent Access Token) من تطبيق Meta الخاص بك
WHATSAPP_TOKEN=

# معرّف رقم الهاتف (Phone Number ID) من لوحة WhatsApp في Meta
WHATSAPP_PHONE_NUMBER_ID=

# رمز التحقق — اخترْه بنفسك (أي نص سري)، وضعه نفسه في إعداد Webhook داخل Meta
WHATSAPP_VERIFY_TOKEN=baigr_verify_change_me

# إصدار Graph API (اختياري)
GRAPH_API_VERSION=v21.0

# سر التطبيق (App Secret) من إعدادات تطبيق Meta — للتحقق الأمني من توقيع الويبهوك (يُنصح به)
WHATSAPP_APP_SECRET=

# ===== Claude API (Anthropic) =====
ANTHROPIC_API_KEY=

# النموذج — الافتراضي هو الأذكى (claude-opus-5).
# للتكلفة الأقل مع جودة عالية جدًا يمكن استخدام: claude-sonnet-5
MODEL=claude-opus-5

# ===== سلوك الرد =====
# مدة الانتظار قبل الرد بالمللي ثانية (10 ثوانٍ = 10000) — يجعل الرد يبدو بشريًا
# ويجمع الرسائل المتتابعة في رد واحد ذكي
REPLY_DELAY_MS=10000

# رسالة التحويل لمختص بشري (اختياري)
HUMAN_HANDOFF_NOTE=سيتواصل معك أحد مختصينا خلال دقائق

# ===== الحفظ الدائم =====
# مسار قاعدة بيانات SQLite (تُنشأ تلقائيًا)
DB_PATH=data/baigr.db

# ===== التنبيهات والإدارة =====
# رقم واتساب صاحب الوكالة لاستقبال تنبيهات الصفقات الساخنة والتحويل البشري (بصيغة دولية بدون +)
OWNER_WA_ID=

# مفتاح سري لحماية لوحة الإحصائيات /stats و /release
ADMIN_KEY=

# ===== المتابعة التلقائية للعميل الصامت =====
FOLLOWUP_ENABLED=true
# بعد كم ساعة صمت نرسل متابعة
FOLLOWUP_HOURS=6
# أقصى عدد رسائل متابعة لكل عميل
FOLLOWUP_MAX=2
# كل كم مللي ثانية نفحص العملاء الصامتين (افتراضي 15 دقيقة)
FOLLOWUP_CHECK_MS=900000
